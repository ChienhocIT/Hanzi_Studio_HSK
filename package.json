{
  "name": "hanzi-studio",
  "version": "4.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --env-file-if-exists=.env.local scripts/build.mjs",
    "vercel-build": "node scripts/release-build.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:db": "node scripts/test-db.mjs",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build",
    "check:cloud": "node --env-file-if-exists=.env.local scripts/cloud-check.mjs",
    "data:import-reference": "node scripts/import-reference.mjs",
    "data:import-hsk3": "node scripts/import-hsk3.mjs",
    "db:seed-vocabulary": "node --env-file-if-exists=.env.local scripts/seed-vocabulary.mjs",
    "db:seed-glosses": "node --env-file-if-exists=.env.local scripts/seed-glosses.mjs",
    "db:seed-examples": "node --env-file-if-exists=.env.local scripts/seed-examples.mjs",
    "db:promote-admin": "node --env-file-if-exists=.env.local scripts/promote-admin.mjs",
    "auth:configure": "node --env-file-if-exists=.env.local scripts/configure-auth.mjs",
    "db:bundle": "node scripts/bundle-migrations.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "hanzi-writer": "3.7.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=22"
  }
}
