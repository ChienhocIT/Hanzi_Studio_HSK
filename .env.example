# Public browser configuration only. Never put service_role or secret keys here.
HANZI_SUPABASE_URL=
HANZI_SUPABASE_PUBLISHABLE_KEY=

# Operator-only values for .env.local. The build never copies them into dist/.
# Supabase personal access token (https://supabase.com/dashboard/account/tokens):
# used by auth:configure, db:seed-vocabulary and db:promote-admin when POSTGRES_URL is not set.
SUPABASE_ACCESS_TOKEN=
# Custom SMTP for Auth emails (all four required together).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SENDER_NAME=Hanzi Studio
# AI tutor (server only, set in Vercel env): Google AI Studio key and optional model fallback list.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite
# Optional: models for YouTube subtitles (default gemini-3.6-flash,gemini-3.1-flash-lite).
GEMINI_VIDEO_MODELS=
# Free fallbacks used in order when Gemini is exhausted or overloaded (each optional).
# Groq: chat + Whisper speech-to-text (console.groq.com/keys).
GROQ_API_KEY=
# OpenRouter: free chat models, default router "openrouter/free" (openrouter.ai/keys).
OPENROUTER_API_KEY=
# Cloudflare Workers AI: chat, Whisper and MeloTTS Mandarin voice (dash.cloudflare.com > AI > Workers AI > REST API).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Google OAuth web client (Google Cloud Console > Google Auth Platform > Clients).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
